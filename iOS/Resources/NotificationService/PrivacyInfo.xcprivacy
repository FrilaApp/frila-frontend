<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <!-- A extensão não coleta nada: só compara o vinculo_id do aviso com o guardado no App Group,
         no aparelho, e troca o texto do aviso. Nada sai daqui. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- 1C8F.1: leitura do UserDefaults do App Group (group.com.frila.org.app), onde
                     o app grava o vinculo_id (VinculoNoGrupoDoApp). É o único uso de API da lista
                     de motivos obrigatórios; o CA92.1 (dados do próprio app) não se aplica aqui. -->
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
