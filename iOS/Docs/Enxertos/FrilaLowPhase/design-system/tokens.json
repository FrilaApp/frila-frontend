{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Frila Design System Tokens",
  "version": "1.2.0",
  "description": "Design tokens for Frila (FindJob & Opportunities for Freelancers), synthesized from Airbnb marketplace mechanics and Artsy editorial gallery aesthetics with iOS 26+ Liquid Glass.",
  "brand": {
    "color": {
      "base": "#EA5A36",
      "space": "oklch",
      "oklch": "oklch(0.6510 0.1856 35.10deg)",
      "wcagRule": "Use for primary CTA buttons (with white text), active pills, and indicators (>=3.0:1 UI components / large text). For naked body text, use primary-600 or primary-700."
    }
  },
  "rules": {
    "defaultParadigm": "swiss",
    "italic": "forbidden — serif and sans oblique alike; titles are always upright",
    "digits": "proportional by default, including hero prices; tabular only for values that animate or align in a column",
    "icons": "SF Symbols only — no emoji or text glyphs as icons in badges, chips or pills",
    "money": {
      "currency": "USD",
      "locale": "en_US",
      "fractionDigits": 0,
      "rateUnit": "/hr",
      "examples": ["$140/hr", "$33,600", "Est. $33,600"]
    }
  },
  "color": {
    "primary": {
      "50": { "value": "#FFF1EC", "oklch": "oklch(0.970 0.020 35.10deg)", "role": "subtle tint, chip background" },
      "100": { "value": "#FFDDD2", "oklch": "oklch(0.930 0.050 35.10deg)", "role": "tag hover, light badge" },
      "200": { "value": "#FFB6A1", "oklch": "oklch(0.850 0.100 35.10deg)", "role": "secondary border, soft highlight" },
      "300": { "value": "#FF8B6D", "oklch": "oklch(0.760 0.150 35.10deg)", "role": "accent graphic, disabled button" },
      "400": { "value": "#F26643", "oklch": "oklch(0.680 0.180 35.10deg)", "role": "interactive hover state" },
      "500": { "value": "#EA5A36", "oklch": "oklch(0.651 0.186 35.10deg)", "role": "brand anchor, primary CTA, active pill" },
      "600": { "value": "#C03710", "oklch": "oklch(0.540 0.180 35.10deg)", "role": "active press state, accessible text links (5.53:1 contrast)" },
      "700": { "value": "#9D2701", "oklch": "oklch(0.460 0.160 35.10deg)", "role": "dark accent, high-contrast link text (7.71:1 contrast)" },
      "800": { "value": "#781D03", "oklch": "oklch(0.380 0.130 35.10deg)", "role": "deep brand text, icon fill (10.63:1 contrast)" },
      "900": { "value": "#4F1506", "oklch": "oklch(0.290 0.090 35.10deg)", "role": "dark brand backdrop" },
      "950": { "value": "#2C0903", "oklch": "oklch(0.200 0.060 35.10deg)", "role": "deepest shade" }
    },
    "neutral": {
      "canvas": { "value": "#FFFFFF", "oklch": "oklch(1.000 0.000 0)", "role": "gallery pure white wall" },
      "surface": { "value": "#FBFBFA", "oklch": "oklch(0.985 0.003 40.0)", "role": "subtle card surface" },
      "input": { "value": "#F2F2F0", "oklch": "oklch(0.960 0.005 40.0)", "role": "form inputs, search background" },
      "divider": { "value": "#E5E5E3", "oklch": "oklch(0.910 0.005 40.0)", "role": "1px crisp architectural hairline" },
      "border": { "value": "#CECECB", "oklch": "oklch(0.820 0.008 40.0)", "role": "interactive control border" },
      "muted": { "value": "#767571", "oklch": "oklch(0.520 0.012 40.0)", "role": "secondary metadata, client studio (4.61:1 contrast)" },
      "text": { "value": "#1B1A18", "oklch": "oklch(0.180 0.012 40.0)", "role": "primary body copy, display headlines (17.39:1 contrast)" },
      "ink": { "value": "#090908", "oklch": "oklch(0.100 0.008 40.0)", "role": "stark black high-intent pill CTA (19.92:1 contrast)" }
    },
    "semantic": {
      "escrowVerified": { "value": "#008639", "oklch": "oklch(0.605 0.160 145.0deg)", "role": "escrow deposit badge (4.70:1 contrast on white)" },
      "warning": { "value": "#C97A00", "oklch": "oklch(0.650 0.150 75.0deg)", "role": "expiring brief graphic indicator" },
      "warningText": { "value": "#9E5C00", "oklch": "oklch(0.550 0.160 70.0deg)", "role": "expiring brief text label (5.27:1 contrast on white)" },
      "error": { "value": "#D82020", "oklch": "oklch(0.580 0.210 25.0deg)", "role": "input error, deadline passed (5.06:1 contrast on white)" }
    }
  },
  "paradigms": {
    "swiss": {
      "name": "Swiss Neo-Grotesque",
      "axis": "Structure & Spatial Geometry",
      "fontFamily": {
        "display": "Suisse Int'l, Neue Haas Grotesk, Inter Tight, Helvetica Neue, sans-serif",
        "placard": "Suisse Int'l, Neue Haas Grotesk, Inter Tight, Helvetica Neue, sans-serif",
        "entity": "Suisse Int'l, Neue Haas Grotesk, Inter Tight, Helvetica Neue, sans-serif",
        "body": "Suisse Int'l, Neue Haas Grotesk, Inter Tight, Helvetica Neue, sans-serif",
        "micro": "Suisse Int'l, Neue Haas Grotesk, Inter Tight, Helvetica Neue, sans-serif",
        "metric": "SF Pro, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "hierarchy": {
        "display": { "size": "34px", "lineHeight": "1.10", "weight": "800", "tracking": "-0.035em" },
        "placard": { "size": "18px", "lineHeight": "1.28", "weight": "500", "style": "normal", "tracking": "-0.015em" },
        "entity": { "size": "16px", "lineHeight": "1.20", "weight": "700", "tracking": "-0.02em", "transform": "uppercase" },
        "body": { "size": "14.5px", "lineHeight": "1.45", "weight": "400", "tracking": "-0.005em" },
        "micro": { "size": "10.5px", "lineHeight": "1.15", "weight": "700", "tracking": "+0.06em", "transform": "uppercase" },
        "metric": { "size": "22px", "lineHeight": "1.10", "weight": "800", "tracking": "-0.5px", "fontFeatures": "'pnum' 1, 'lnum' 1" },
        "metricTabular": { "size": "22px", "lineHeight": "1.10", "weight": "800", "tracking": "-0.5px", "fontFeatures": "'tnum' 1, 'lnum' 1", "usage": "Only for values that animate or align in a column (histogram, slider, counters)." }
      },
      "default": true
    },
    "curatorial": {
      "name": "Curatorial Placard",
      "axis": "Expressive Contrast & Cultural Distinction",
      "fontFamily": {
        "display": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
        "placard": "Newsreader, New York, Georgia, serif",
        "entity": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
        "body": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
        "micro": "JetBrains Mono, SF Mono, Menlo, monospace",
        "metric": "SF Pro, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "hierarchy": {
        "display": { "size": "32px", "lineHeight": "1.15", "weight": "700", "tracking": "-0.02em" },
        "placard": { "size": "18px", "lineHeight": "1.35", "weight": "400", "style": "normal", "tracking": "-0.01em" },
        "entity": { "size": "17px", "lineHeight": "1.25", "weight": "700", "tracking": "-0.015em" },
        "body": { "size": "15px", "lineHeight": "1.50", "weight": "400", "tracking": "0em" },
        "micro": { "size": "11px", "lineHeight": "1.20", "weight": "600", "tracking": "+0.08em", "transform": "uppercase" },
        "metric": { "size": "22px", "lineHeight": "1.15", "weight": "700", "tracking": "-0.4px", "fontFeatures": "'pnum' 1, 'lnum' 1" },
        "metricTabular": { "size": "22px", "lineHeight": "1.15", "weight": "700", "tracking": "-0.4px", "fontFeatures": "'tnum' 1, 'lnum' 1", "usage": "Only for values that animate or align in a column (histogram, slider, counters)." }
      }
    },
    "atelier": {
      "name": "Humanist Atelier",
      "axis": "Warmth & Tactility",
      "fontFamily": {
        "display": "Fraunces, Lora, Baskerville, Palatino Linotype, serif",
        "placard": "Fraunces, Lora, Baskerville, Palatino Linotype, serif",
        "entity": "Plus Jakarta Sans, Optima, Gill Sans, sans-serif",
        "body": "Plus Jakarta Sans, Optima, Gill Sans, sans-serif",
        "micro": "Plus Jakarta Sans, Optima, Gill Sans, sans-serif",
        "metric": "SF Pro, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "hierarchy": {
        "display": { "size": "32px", "lineHeight": "1.20", "weight": "600", "tracking": "-0.015em" },
        "placard": { "size": "19px", "lineHeight": "1.35", "weight": "500", "style": "normal", "tracking": "-0.01em" },
        "entity": { "size": "16px", "lineHeight": "1.30", "weight": "600", "tracking": "0em" },
        "body": { "size": "15px", "lineHeight": "1.55", "weight": "400", "tracking": "+0.005em" },
        "micro": { "size": "11px", "lineHeight": "1.25", "weight": "600", "tracking": "+0.12em", "variantCaps": "all-small-caps" },
        "metric": { "size": "22px", "lineHeight": "1.20", "weight": "600", "tracking": "-0.4px", "fontFeatures": "'pnum' 1, 'lnum' 1" },
        "metricTabular": { "size": "22px", "lineHeight": "1.20", "weight": "600", "tracking": "-0.4px", "fontFeatures": "'tnum' 1, 'lnum' 1", "usage": "Only for values that animate or align in a column (histogram, slider, counters)." }
      }
    },
    "archival": {
      "name": "Hyper-Dense Archival",
      "axis": "Density & Information Throughput",
      "fontFamily": {
        "display": "Commit Mono, SF Mono, JetBrains Mono, monospace",
        "placard": "Commit Mono, SF Mono, JetBrains Mono, monospace",
