        "body": "Geist, Inter Tight, Roboto Condensed, sans-serif",
        "micro": "Commit Mono, SF Mono, JetBrains Mono, monospace",
        "metric": "SF Pro, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "hierarchy": {
        "display": { "size": "26px", "lineHeight": "1.15", "weight": "700", "tracking": "-0.03em" },
        "placard": { "size": "15px", "lineHeight": "1.25", "weight": "600", "tracking": "-0.01em", "style": "normal" },
        "entity": { "size": "14px", "lineHeight": "1.20", "weight": "700", "tracking": "+0.02em", "transform": "uppercase" },
