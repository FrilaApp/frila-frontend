        "placard": "SF Pro Rounded, -apple-system, BlinkMacSystemFont, sans-serif",
        "entity": "SF Pro Rounded, -apple-system, BlinkMacSystemFont, sans-serif",
        "body": "-apple-system, BlinkMacSystemFont, SF Pro Text, sans-serif",
        "micro": "SF Pro Rounded, -apple-system, BlinkMacSystemFont, sans-serif",
