      },
      "hierarchy": {
        "display": { "size": "32px", "lineHeight": "1.18", "weight": "750", "tracking": "-0.025em" },
        "placard": { "size": "18px", "lineHeight": "1.30", "weight": "550", "tracking": "-0.015em", "style": "normal" },
        "entity": { "size": "16px", "lineHeight": "1.22", "weight": "700", "tracking": "-0.01em" },
        "body": { "size": "15px", "lineHeight": "1.48", "weight": "450", "tracking": "0em" },
        "micro": { "size": "11px", "lineHeight": "1.15", "weight": "650", "tracking": "+0.07em", "transform": "uppercase" },
        "metric": { "size": "22px", "lineHeight": "1.15", "weight": "700", "tracking": "-0.4px", "fontFeatures": "'pnum' 1, 'lnum' 1" },
        "metricTabular": { "size": "22px", "lineHeight": "1.15", "weight": "700", "tracking": "-0.4px", "fontFeatures": "'tnum' 1, 'lnum' 1", "usage": "Only for values that animate or align in a column (histogram, slider, counters)." }
      }
    }
  },
  "liquidGlass": {
    "regular": {
      "background": "rgba(255, 255, 255, 0.82)",
      "backdropFilter": "blur(20px) saturate(180%)",
      "borderTop": "1px solid rgba(255, 255, 255, 0.60)",
      "borderBottom": "1px solid rgba(0, 0, 0, 0.06)"
    },
    "prominent": {
      "background": "rgba(234, 90, 54, 0.92)",
      "backdropFilter": "blur(24px) saturate(200%)",
      "borderTop": "1px solid rgba(255, 255, 255, 0.35)",
      "borderBottom": "1px solid rgba(0, 0, 0, 0.20)",
      "boxShadow": "0 4px 20px rgba(234, 90, 54, 0.28)"
    },
    "backdrop": {
      "background": "rgba(15, 17, 21, 0.40)",
      "backdropFilter": "blur(16px)"
    }
  },
  "radii": {
    "none": "0px",
    "nested": "8px",
    "input": "14px",
    "card": "16px",
    "sheet": "24px",
    "pill": "9999px"
  },
  "shadows": {
    "card": "none",
    "floatingSearch": "0 4px 14px rgba(0, 0, 0, 0.08)",
    "bottomBar": "0 -1px 0 #E5E5E3, 0 -4px 16px rgba(0, 0, 0, 0.03)",
    "brandGlow": "0 4px 20px rgba(234, 90, 54, 0.28)"
  }
}
