// Referência do formato. Prefira gerar Secrets.xcconfig com Scripts/generate-supabase-secrets.sh,
// que valida os valores e grava o arquivo ignorado pelo Git com permissão 600.
// URLs e chaves publicaveis podem estar no binario; service_role, SMTP, APNs .p8 e FCM service account nunca.
FRILA_SUPABASE_DEV_URL = https:/$()/seu-projeto-dev.supabase.co
FRILA_SUPABASE_DEV_PUBLISHABLE_KEY = cole-a-chave-publicavel-dev-aqui
FRILA_SUPABASE_PROD_URL = https:/$()/seu-projeto-prod.supabase.co
FRILA_SUPABASE_PROD_PUBLISHABLE_KEY = cole-a-chave-publicavel-prod-aqui
