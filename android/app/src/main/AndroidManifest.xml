<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RNF01 (cartão 9Q0sJIzW): detecção reativa de conectividade via ConnectivityManager. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      O app não usa biometria: o recurso está desligado (C0-11) e nada no app o liga. A biblioteca androidx.biometric ainda está no
      projeto e traria estas duas permissões na mescla do manifesto; saem aqui. Religar a biometria exige tirar estas duas linhas.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:name=".FrilaApplication"
        android:label="Frila"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- L1-6 (C1, 08/11/2026): coleta do Crashlytics DESLIGADA, como o iOS 1.1. Ligar é decisão jurídica (trocar para true). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- As sessões do Firebase (do Crashlytics) também ficam desligadas: só mandariam dado de uso ao Google. -->
        <meta-data
            android:name="firebase_sessions_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="uiMode"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="frila"
                    android:host="vagas"
                    android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="frila"
                    android:host="meus_turnos" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="frila"
                    android:host="suporte" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="frila"
                    android:host="chamadas" />
            </intent-filter>
            <!--
              Android App Links HTTPS (pré-Prod/Release; não ativa login social em Release).
              Dependências externas antes de habilitar social fora de DEBUG (sem inventar SHA-256 nem alterar remoto):
              1. Domínio frilabr.com servindo https://frilabr.com/.well-known/assetlinks.json (HTTP 200, JSON);
              2. package_name br.com.frila.app + certificado SHA-256 real de Release/Play Signing (operador Cauê);
              3. https://frilabr.com/app/auth/callback?tx=* na uri_allow_list do Supabase Auth (operador Cauê);
              4. Validação real via adb shell pm get-app-links br.com.frila.app.
              Em debug, src/debug/AndroidManifest.xml preserva frila-auth://auth/callback para DEV.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="frilabr.com"
                    android:path="/app/auth/callback" />
            </intent-filter>
        </activity>

        <!--
          FCM sem métrica ao Google (decisão do O2, 17/11): a entrega do push não é exportada para o BigQuery, e o token só nasce quando o app o pede
          (`TokenDoFcm`, depois da sessão), não na primeira abertura. Sem Firebase Analytics no app (nem `firebase-analytics`, nem `play-services-measurement`).
        -->
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

    </application>

</manifest>
