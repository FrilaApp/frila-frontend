/**
 * Worker da web do Frila. Plano grátis da Cloudflare.
 * O ambiente padrão é o de dev (Supabase dev). Produção: CLOUDFLARE_ENV=producao no build.
 * Endereço e chave publicável do Supabase NÃO ficam aqui: vêm de `.dev.vars` (local)
 * e das variáveis do Worker (painel ou `wrangler secret put`).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frila-web-dev",
	"compatibility_date": "2026-11-16",
	"main": "./workers/app.ts",
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"AMBIENTE": "dev",
		// "1" mostra a web; qualquer outro valor mostra só a página "em breve".
		"WEB_LIGADA": "1"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"env": {
		"producao": {
			"name": "frila-web",
			"preview_urls": false,
			"vars": {
				"AMBIENTE": "producao",
				"WEB_LIGADA": "0"
			}
		}
	}
}
